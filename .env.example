# Tavily API Key (Get yours at https://tavily.com)
TAVILY_API_KEY=tvly-your-api-key-here

# Bifrost / Upstream LLM Configuration (Bifrost Gateway endpoint or Direct LLM)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-llm-or-bifrost-key

# Heimdall Configuration
HEIMDALL_PORT=8000
HEIMDALL_SIMILARITY_THRESHOLD=0.88
HEIMDALL_FRESHNESS_THRESHOLD=70
